---
import '@fontsource-variable/manrope';
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'


interface Props {
	title: string
	description: string
}

const { description, title } = Astro.props

---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/img/tomas-ico.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>


	</head>
	
		
		<body> 
			
			<Header />
			<slot />
			<Footer />
</div>
	</body>
</html>

<style is:global>
	@import "tailwindcss";
	@custom-variant dark (&:where(.dark, .dark *));

	:root {
        color-scheme: light;
    }
    
    :root.dark {
        color-scheme: dark;
    }
	html {
		font-family: 'Manrope Variable', system-ui, sans-serif;
		scroll-behavior: smooth;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		background-color: #f8fafc;
		background-image:
			radial-gradient(ellipse 80% 40% at 50% -10%, rgba(6, 182, 212, 0.12) 0%, transparent 60%),
			radial-gradient(ellipse 40% 30% at 90% 50%, rgba(139, 92, 246, 0.07) 0%, transparent 60%);
	}

	.dark body {
		position: relative;
		min-height: 100vh;
		width: 100%;
		background-color: #0c1220;
		background-image:
			radial-gradient(ellipse 80% 40% at 50% -5%, rgba(6, 182, 212, 0.12) 0%, transparent 55%),
			radial-gradient(ellipse 50% 40% at 0% 70%, rgba(139, 92, 246, 0.10) 0%, transparent 50%),
			radial-gradient(ellipse 40% 30% at 100% 80%, rgba(6, 182, 212, 0.07) 0%, transparent 50%);
	}

	.nav-link.active {
        @apply dark:text-cyan-400 text-cyan-700 font-semibold;
        text-decoration: none;
        background-color: rgb(207 250 254 / 0.5);
    }

	.dark .nav-link.active {
		background-color: rgb(8 145 178 / 0.15);
	}

	@layer utilities {
  .neon-effect {
    text-shadow: 0 0 5px #ff80ab, 0 0 10px #ff80ab, 0 0 20px #ff80ab, 0 0 40px #ff80ab;
    animation: neon-pulse 1.5s infinite alternate;
  }

  @keyframes neon-pulse {
    from {
      text-shadow: 0 0 5px #ff80ab, 0 0 10px #ff80ab, 0 0 20px #ff80ab, 0 0 40px #ff80ab;
    }
    to {
      text-shadow: 0 0 10px #ff80ab, 0 0 20px #ff80ab, 0 0 30px #ff80ab, 0 0 50px #ff80ab;
    }
  }
}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}


</style>
