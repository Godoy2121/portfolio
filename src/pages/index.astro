---
import Badge from '../components/Badge.astro';
import Layout from '../layouts/Layout.astro';
import Linkedin from '../components/icons/Linkedin.astro';
import Github from '../components/icons/Github.astro';
import Mail from '../components/icons/Mail.astro';
import Socialmedia from '../components/Socialmedia.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Contact from '../components/Contact.astro';
import AboutMe from '../components/AboutMe.astro';
import CV from '../components/icons/CV.astro';
import Code from '../components/icons/Code.astro';
import ContactIcon from '../components/icons/Contact-icon.astro';
import Myself from '../components/icons/Myself.astro';
import LanguageSelector from '../components/LanguageSelector.astro';
---

<Layout title="Tomás Antonaya | Desarrollador Web & Sistemas"
		description="Portfolio de Tomás Antonaya Godoy — Desarrollador web, administrador de sistemas y apasionado de la tecnología.">
	<main class="md:px-6 px-5 max-w-5xl mx-auto">

		<SectionContainer class="pt-28 pb-24">
			<div class="flex flex-col md:flex-row md:items-center gap-6 mb-6">
				<img
					class="rounded-full border-2 border-cyan-500/40 size-20 md:size-24 shadow-lg shadow-cyan-500/10"
					src="/img/tomas_photo.jpg"
					alt="Tomás Antonaya photo" />
				<div>
					<h1 class="text-3xl md:text-4xl lg:text-5xl font-bold
						text-gray-900 dark:text-gray-100 mb-3 leading-tight">
						<LanguageSelector
							esp="¡Hola, soy Tomás!"
							eng="Hey, I'm Tomás!"
							cat="Hola, sóc en Tomàs!"
						/>
					</h1>
					<a href="https://www.linkedin.com/in/antonayagodoy/"
						target="_blank" rel="noopener noreferrer">
						<Badge>
							<LanguageSelector
								esp="Abierto a nuevas oportunidades"
								eng="Open to new opportunities"
								cat="Obert a noves oportunitats"
							/>
						</Badge>
					</a>
				</div>
			</div>

			<p class="text-base md:text-lg lg:text-xl max-w-2xl leading-relaxed
				text-gray-700 dark:text-gray-300 mb-8">
				<span class="font-semibold text-cyan-700 dark:text-cyan-400">
					<LanguageSelector
						esp="Desarrollador web & administrador de sistemas"
						eng="Web developer & systems administrator"
						cat="Desenvolupador web & administrador de sistemes"/>
				</span>
				<span class="text-gray-500 dark:text-gray-500">&nbsp;·&nbsp;</span>
				<span class="text-purple-700 dark:text-purple-400">Barcelona</span>
				<br/>
				<span class="text-gray-600 dark:text-gray-400 text-base">
					<LanguageSelector
						esp="Construyo apps web con atención al detalle y curiosidad constante."
						eng="I build web apps with attention to detail and constant curiosity."
						cat="Construeixo apps web amb atenció al detall i curiositat constant."/>
				</span>
			</p>

			<nav class="flex flex-wrap gap-3 text-sm">
				<Socialmedia href="https://www.linkedin.com/in/antonayagodoy/">
					<Linkedin class="size-4 md:size-5"/>
					LinkedIn
				</Socialmedia>
				<Socialmedia href="https://github.com/Godoy2121">
					<Github class="size-4 md:size-5"/>
					GitHub
				</Socialmedia>
				<Socialmedia href="mailto:tomasantonayagodoy@gmail.com">
					<Mail class="size-4 md:size-5"/>
					tomasantonayagodoy@gmail.com
				</Socialmedia>
			</nav>
		</SectionContainer>

		<SectionContainer id="experiencia" class="scroll-mt-20 pb-16">
			<h2 class="lg:text-3xl text-2xl font-bold mb-8
				flex gap-x-3 items-center text-gray-900 dark:text-gray-100">
				<CV class="size-7 text-cyan-600 dark:text-cyan-400"/>
				<LanguageSelector
					esp="Experiencia Laboral"
					eng="Work Experience"
					cat="Experiència Laboral"/>
			</h2>
			<Experience />
		</SectionContainer>

		<SectionContainer id="proyectos" class="scroll-mt-20 pb-16">
			<h2 class="lg:text-3xl text-2xl font-bold mb-2
				flex gap-x-3 items-center text-gray-900 dark:text-gray-100">
				<Code class="size-7 text-cyan-600 dark:text-cyan-400"/>
				<LanguageSelector
					esp="Proyectos"
					eng="Projects"
					cat="Projectes"/>
			</h2>
			<p class="text-sm text-gray-500 dark:text-gray-500 mb-8">
				<LanguageSelector
					esp="Proyectos personales desarrollados con tecnologías web modernas."
					eng="Personal projects built with modern web technologies."
					cat="Projectes personals desenvolupats amb tecnologies web modernes."/>
			</p>
			<Projects />
		</SectionContainer>

		<SectionContainer id="sobremi" class="scroll-mt-20 pb-16">
			<h2 class="lg:text-3xl text-2xl font-bold mb-8
				flex gap-x-3 items-center text-gray-900 dark:text-gray-100">
				<Myself class="size-7 text-cyan-600 dark:text-cyan-400"/>
				<LanguageSelector
					esp="CV & Sobre mí"
					eng="CV & About me"
					cat="CV & Sobre mi"/>
			</h2>
			<AboutMe />
		</SectionContainer>

		<SectionContainer id="contacto" class="scroll-mt-20 pb-16">
			<h2 class="lg:text-3xl text-2xl font-bold mb-8
				flex gap-x-3 items-center text-gray-900 dark:text-gray-100">
				<ContactIcon class="size-7 text-cyan-600 dark:text-cyan-400"/>
				<LanguageSelector
					esp="Contacto"
					eng="Contact"
					cat="Contacte"/>
			</h2>
			<Contact />
		</SectionContainer>
	</main>
</Layout>
