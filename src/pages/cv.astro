---
// CV standalone — sin header/footer, optimizado para imprimir a PDF
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>CV – Tomás Antonaya Godoy | Analista de Datos</title>
  <meta name="robots" content="noindex" />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --accent: #0e7490;
      --accent-light: #e0f2fe;
      --dark: #1e293b;
      --mid: #475569;
      --light: #94a3b8;
      --bg-left: #1e293b;
      --text-left: #e2e8f0;
    }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 10.5pt;
      color: var(--dark);
      background: #f1f5f9;
      line-height: 1.5;
    }

    /* ── Botón de impresión (se oculta al imprimir) ── */
    .print-btn {
      position: fixed;
      top: 1rem;
      right: 1rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 0.5rem;
      padding: 0.55rem 1.1rem;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(14,116,144,.35);
      z-index: 100;
      transition: background .15s;
    }
    .print-btn:hover { background: #0c6280; }

    /* ── Hoja A4 ── */
    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 1.5rem auto;
      background: #fff;
      display: grid;
      grid-template-columns: 64mm 1fr;
      box-shadow: 0 4px 24px rgba(0,0,0,.12);
    }

    /* ── Columna izquierda ── */
    .sidebar {
      background: var(--bg-left);
      color: var(--text-left);
      padding: 2rem 1.4rem;
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    .sidebar-section-title {
      font-size: 7.5pt;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--accent);
      border-bottom: 1px solid #334155;
      padding-bottom: .35rem;
      margin-bottom: .75rem;
    }

    .contact-item {
      display: flex;
      align-items: flex-start;
      gap: .5rem;
      font-size: 9pt;
      margin-bottom: .45rem;
      color: #cbd5e1;
    }
    .contact-item svg { flex-shrink: 0; margin-top: .15rem; }
    .contact-item a { color: #cbd5e1; text-decoration: none; }
    .contact-item a:hover { color: #fff; }

    .skill-group { margin-bottom: .9rem; }
    .skill-group-title {
      font-size: 8pt;
      font-weight: 600;
      color: #94a3b8;
      margin-bottom: .4rem;
    }
    .skill-pill {
      display: inline-block;
      background: #334155;
      color: #e2e8f0;
      border-radius: 3px;
      padding: .15rem .5rem;
      font-size: 8pt;
      margin: .2rem .2rem 0 0;
    }
    .skill-pill.highlight {
      background: var(--accent);
      color: #fff;
      font-weight: 600;
    }

    .lang-item {
      display: flex;
      justify-content: space-between;
      font-size: 9pt;
      margin-bottom: .35rem;
      color: #cbd5e1;
    }
    .lang-level { color: #94a3b8; font-size: 8.5pt; }

    /* ── Columna derecha ── */
    .main {
      padding: 2rem 1.8rem 2rem 1.6rem;
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
    }

    /* Cabecera */
    .cv-header { border-bottom: 2px solid var(--accent-light); padding-bottom: 1rem; }
    .cv-name {
      font-size: 22pt;
      font-weight: 700;
      color: var(--dark);
      letter-spacing: -.02em;
      line-height: 1.1;
    }
    .cv-role {
      font-size: 11pt;
      font-weight: 500;
      color: var(--accent);
      margin-top: .25rem;
      letter-spacing: .01em;
    }

    /* Secciones */
    .section-title {
      font-size: 8.5pt;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--accent);
      border-bottom: 1.5px solid var(--accent-light);
      padding-bottom: .3rem;
      margin-bottom: .85rem;
    }

    /* Perfil */
    .profile-text {
      font-size: 9.5pt;
      color: var(--mid);
      line-height: 1.6;
    }

    /* Experiencia */
    .exp-item { margin-bottom: 1.1rem; }
    .exp-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: .5rem;
    }
    .exp-title {
      font-size: 10pt;
      font-weight: 600;
      color: var(--dark);
    }
    .exp-date {
      font-size: 8pt;
      color: var(--light);
      white-space: nowrap;
      flex-shrink: 0;
    }
    .exp-company {
      font-size: 9pt;
      color: var(--accent);
      font-weight: 500;
      margin: .1rem 0 .4rem;
    }
    .exp-location {
      font-size: 8pt;
      color: var(--light);
    }
    .exp-bullets {
      list-style: none;
      margin-top: .4rem;
    }
    .exp-bullets li {
      font-size: 9pt;
      color: var(--mid);
      padding-left: .9rem;
      position: relative;
      margin-bottom: .25rem;
      line-height: 1.5;
    }
    .exp-bullets li::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: var(--accent);
      font-size: 8pt;
      top: .05rem;
    }

    /* Formación */
    .edu-title { font-size: 10pt; font-weight: 600; color: var(--dark); }
    .edu-sub { font-size: 9pt; color: var(--mid); margin-top: .15rem; }

    /* ── PRINT ── */
    @media print {
      @page {
        size: A4;
        margin: 0;
      }
      body { background: #fff; }
      .print-btn { display: none !important; }
      .page {
        width: 210mm;
        min-height: 297mm;
        margin: 0;
        box-shadow: none;
      }
    }
  </style>
</head>
<body>

<button class="print-btn" onclick="window.print()">
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
