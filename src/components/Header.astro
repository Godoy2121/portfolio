---
import ThemeIcon from './ThemeIcons.astro';
import LanguageSelector from './LanguageSelector.astro';
---

<header class="fixed top-0 left-0 w-full z-50
    bg-white/80 dark:bg-gray-900/85 backdrop-blur-md
    border-b border-gray-200/60 dark:border-gray-700/40
    shadow-sm py-2 md:py-3 transition-colors duration-300">
    <nav class="flex flex-col md:flex-row items-center justify-between px-4 md:px-6 max-w-5xl mx-auto">

        <div class="flex items-center justify-between w-full md:w-auto mb-2 md:mb-0">
            <div class="flex items-center gap-1 bg-gray-100/80 dark:bg-gray-800/80 rounded-lg p-0.5">
                <button class="language-btn px-2.5 py-1 rounded-md text-xs font-semibold
                               text-gray-600 dark:text-gray-400
                               hover:bg-white dark:hover:bg-gray-700
                               hover:text-gray-900 dark:hover:text-white
                               transition-all duration-150"
                        data-lang="es" id="lang-es">ESP</button>
                <button class="language-btn px-2.5 py-1 rounded-md text-xs font-semibold
                               text-gray-600 dark:text-gray-400
                               hover:bg-white dark:hover:bg-gray-700
                               hover:text-gray-900 dark:hover:text-white
                               transition-all duration-150"
                        data-lang="en" id="lang-en">ENG</button>
                <button class="language-btn px-2.5 py-1 rounded-md text-xs font-semibold
                               text-gray-600 dark:text-gray-400
                               hover:bg-white dark:hover:bg-gray-700
                               hover:text-gray-900 dark:hover:text-white
                               transition-all duration-150"
                        data-lang="ca" id="lang-ca">CAT</button>
            </div>
            <ThemeIcon class="size-5 md:size-6 ml-3 text-gray-600 dark:text-gray-300"/>
        </div>

        <div class="nav-links flex flex-wrap justify-center gap-x-1 md:gap-x-2 gap-y-1 w-full md:w-auto text-xs md:text-sm">
            <a href="#top" class="nav-link px-2.5 py-1.5 rounded-lg font-medium
                                   text-gray-600 dark:text-gray-400
                                   hover:bg-gray-100 dark:hover:bg-gray-800
                                   hover:text-cyan-700 dark:hover:text-cyan-400
                                   transition-colors duration-150 whitespace-nowrap">
                <LanguageSelector esp="Inicio" eng="Home" cat="Inici"/>
            </a>
            <a href="#experiencia" class="nav-link px-2.5 py-1.5 rounded-lg font-medium
                                          text-gray-600 dark:text-gray-400
                                          hover:bg-gray-100 dark:hover:bg-gray-800
                                          hover:text-cyan-700 dark:hover:text-cyan-400
                                          transition-colors duration-150 whitespace-nowrap">
                <LanguageSelector esp="Experiencia" eng="Experience" cat="Experiència"/>
            </a>
            <a href="#proyectos" class="nav-link px-2.5 py-1.5 rounded-lg font-medium
                                         text-gray-600 dark:text-gray-400
                                         hover:bg-gray-100 dark:hover:bg-gray-800
                                         hover:text-cyan-700 dark:hover:text-cyan-400
                                         transition-colors duration-150 whitespace-nowrap">
                <LanguageSelector esp="Proyectos" eng="Projects" cat="Projectes"/>
            </a>
            <a href="#sobremi" class="nav-link px-2.5 py-1.5 rounded-lg font-medium
                                       text-gray-600 dark:text-gray-400
                                       hover:bg-gray-100 dark:hover:bg-gray-800
                                       hover:text-cyan-700 dark:hover:text-cyan-400
                                       transition-colors duration-150 whitespace-nowrap">CV</a>
            <a href="#contacto" class="nav-link px-2.5 py-1.5 rounded-lg font-medium
                                        text-gray-600 dark:text-gray-400
                                        hover:bg-gray-100 dark:hover:bg-gray-800
                                        hover:text-cyan-700 dark:hover:text-cyan-400
                                        transition-colors duration-150 whitespace-nowrap">
                <LanguageSelector esp="Contacto" eng="Contact" cat="Contacte"/>
            </a>
        </div>
    </nav>
</header>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const sections = document.querySelectorAll('section');
        const navLinks = document.querySelectorAll('.nav-link');

        function setActiveLanguage(lang) {
            localStorage.setItem('preferredLanguage', lang);
            document.querySelectorAll('.language-btn').forEach(btn => {
                btn.classList.remove('bg-white', 'dark:bg-gray-700', 'text-gray-900', 'dark:text-white', 'shadow-sm');
            });
            const activeBtn = document.getElementById(`lang-${lang}`);
            if (activeBtn) {
                activeBtn.classList.add('bg-white', 'dark:bg-gray-700', 'text-gray-900', 'dark:text-white', 'shadow-sm');
            }
        }

        document.querySelectorAll('.language-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                setActiveLanguage(btn.dataset.lang);
            });
        });

        const savedLang = localStorage.getItem('preferredLanguage') || 'es';
        setActiveLanguage(savedLang);

        const highlightNavLink = () => {
            let currentSection = '';
            sections.forEach((section) => {
                const sectionTop = section.offsetTop;
                const sectionHeight = section.offsetHeight;
                if (window.scrollY >= sectionTop - sectionHeight / 3) {
                    currentSection = section.getAttribute('id');
                }
            });

            navLinks.forEach((link) => {
                link.classList.remove('active');
                if (link.getAttribute('href') === `#${currentSection}`) {
                    link.classList.add('active');
                }
            });
        };

        window.addEventListener('scroll', highlightNavLink);
        highlightNavLink();
    });
</script>
