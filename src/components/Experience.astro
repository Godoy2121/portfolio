---

<!-- Bug fix: ONE <ol> wrapping all items — previously each map iteration
     created its own <ol>, breaking the continuous timeline border -->
<ol class="relative border-s border-gray-300 dark:border-gray-600 ms-2">
    {EXPERIENCE.map(({ title, date, company, city, description, tags, link }) => (
        <li class="mb-10 ms-6">
            <div class="absolute size-2.5 bg-cyan-500 dark:bg-cyan-400 rounded-full
                        mt-1.5 -start-[1.3rem] border-2 border-white dark:border-gray-900" />

            <time class="text-sm font-medium text-cyan-700 dark:text-cyan-400 mb-1 block">
                <LanguageSelector esp={date.es} eng={date.en} cat={date.ca} />
            </time>

            <h3 class="lg:text-xl md:text-xl text-lg font-semibold
                       text-gray-900 dark:text-gray-100 mb-1 mt-1">
                <LanguageSelector esp={title.es} eng={title.en} cat={title.ca} />
            </h3>

            <h4 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">
                {link ? (
                    <a href={link} target="_blank" rel="noopener noreferrer"
                       class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
                        {company}
                    </a>
                ) : (
                    <span>{company}</span>
                )}
                <span class="mx-1">·</span>
                <span>{city}</span>
            </h4>

            <div class="text-sm md:text-base mb-4 text-pretty leading-relaxed
                        text-gray-600 dark:text-gray-400">
                <LanguageSelector esp={description.es} eng={description.en} cat={description.ca} />
            </div>

            <ul class="flex flex-wrap gap-2">
                {tags.map(({ tag }) => (
                    <li class="flex items-center gap-1.5
                               bg-gray-100/80 dark:bg-gray-800/60
                               border border-gray-200/60 dark:border-gray-700/40
                               px-3 py-1.5 rounded-full text-xs font-medium
                               text-gray-700 dark:text-gray-300">
                        {typeof tag.icon === "string" ? (
                            <img src={tag.icon} alt={tag.name} class="size-4" />
                        ) : (
                            <tag.icon class="size-4" />
                        )}
                        {tag.name}
                    </li>
                ))}
            </ul>
        </li>
    ))}
</ol>
