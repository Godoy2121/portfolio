---
const { esp, eng, cat } = Astro.props;
---

<span class="language-selector">
  <span class="language-text es">{esp}</span>
  <span class="language-text en hidden">{eng}</span>
  <span class="language-text ca hidden">{cat}</span>
</span>

<script is:inline>
  // Guard: only initialise once even though this script block is
  // inlined for every LanguageSelector instance on the page.
  if (!window.__langSelectorReady) {
    window.__langSelectorReady = true;

    function applyLanguage(lang) {
      document.querySelectorAll('.language-text').forEach(el => {
        const show = el.classList.contains(lang);
        el.classList.toggle('hidden', !show);
        el.classList.toggle('inline', show);
      });
      localStorage.setItem('preferredLanguage', lang);

      // Highlight active button
      document.querySelectorAll('.language-btn').forEach(btn => {
        const active = btn.dataset.lang === lang;
        btn.classList.toggle('bg-white', active);
        btn.classList.toggle('dark:bg-gray-700', active);
        btn.classList.toggle('text-gray-900', active);
        btn.classList.toggle('dark:text-white', active);
        btn.classList.toggle('shadow-sm', active);
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.language-btn').forEach(btn => {
        btn.addEventListener('click', () => applyLanguage(btn.dataset.lang));
      });
      applyLanguage(localStorage.getItem('preferredLanguage') || 'es');
    });
  }
</script>
